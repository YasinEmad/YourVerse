# Copy to .env and adjust for your environment.
#
# Base URL of the NestJS backend (Phase 4A). Leave unset to use the in-memory
# mock API (/api/mock). When set, the frontend calls the real backend with
# credentials: "include", so the httpOnly session cookie works across origins.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Firebase client configuration (the Firebase web app). These are PUBLIC
# identifiers — safe to ship to the browser. NEVER add Firebase Admin
# (service-account) credentials here: FIREBASE_PRIVATE_KEY, FIREBASE_CLIENT_EMAIL
# and friends belong in the backend's .env only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

NEXT_PUBLIC_FIREBASE_PROJECT_ID=

NEXT_PUBLIC_FIREBASE_APP_ID=

