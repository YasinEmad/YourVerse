// Yourverse — Phase 1 data model.
//
// Worlds + Catalog (Phase 0) read models, plus the Cart models added in
// Phase 1 (cart module). Order/User/Loyalty/Drop models are NOT here yet —
// later phases add them, and adding them now would let this schema drift from
// what those phases actually need (see backend-architecture.md §4).
//
// NOTE (contract-driven columns): the World/Product/PWP models below follow
// backend-architecture.md §4, with three small additions required by the
// frontend DTOs in Frontend/lib/api/types.ts, which is the binding contract:
//   - World.tagline        (WorldSummaryDto requires a localized tagline)
//   - Product.baseTitle    (the no-world product view-model needs a title)
//   - PWP.subtitle / imageUrl / accentColor  (ProductViewModel fields)
// imageUrl is nullable because the mock catalog has no images and the DTO
// declares it optional.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model World {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      Json // LocalizedTextDto { en, ar }
  tagline   Json // LocalizedTextDto { en, ar }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  presentations ProductWorldPresentation[]
}

model Product {
  id        String   @id @default(cuid())
  slug      String   @unique
  baseTitle String
  basePrice Int // minor units (cents) — serialized to major units at the DTO boundary
  currency  String   @default("USD")
  createdAt DateTime @default(now())

  presentations ProductWorldPresentation[]
  cartItems     CartItem[]
}

// The per-world "skin" of a product: what ProductCard actually renders.
// WorldConfig.productCard.fieldLabels supplies the *labels* ("Stars", "Rating");
// this table supplies the *values* for a given product in a given world.
model ProductWorldPresentation {
  id             String  @id @default(cuid())
  productId      String
  worldId        String
  title          Json // LocalizedTextDto { en, ar }
  subtitle       String?
  primaryValue   String
  secondaryValue String?
  imageUrl       String?
  accentColor    String?
  badge          String?
  isAvailable    Boolean @default(true)
  isFeatured     Boolean @default(false)
  sortWeight     Int     @default(0)

  product Product @relation(fields: [productId], references: [id])
  world   World   @relation(fields: [worldId], references: [id])

  @@unique([productId, worldId])
  @@index([worldId, isAvailable, sortWeight])
}

// A guest (or, Phase 4+, logged-in) shopping cart. Exactly as in
// backend-architecture.md §4: one cart per session, userId nullable until auth
// exists. Postgres is the source of truth; the cart:{sessionId} Redis key only
// caches the hydrated CartDto in front of it (architecture §6).
model Cart {
  id        String   @id @default(cuid())
  sessionId String   @unique // guest session id (signed), or userId once merged
  userId    String?  @unique // Phase 4 wires the User relation; sessionId-only carts suffice here
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}
