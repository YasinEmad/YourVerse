// Yourverse data model.
//
// Worlds + Catalog (Phase 0) read models, Cart (Phase 1), Order/OrderItem
// (Phase 2), and the application User (Phase 4A). Loyalty/Drop models are NOT
// here yet — later phases add them (see backend-architecture.md §4).
//
// DISCREPANCY vs backend-architecture.md §4 (COD-only decision, Phase 2): the
// architecture doc's Order model originally carried a required
// `paymentMethodId String`. This phase deliberately DROPS it — there is no
// payment gateway, every order is Cash on Delivery (COD), so COD is an
// implicit fact of every order rather than a stored choice among options.
// backend-architecture.md has been updated to match (§4/§5). If card/wallet
// payments ever return, that is a new payments/ phase that reintroduces a
// payment-method concept on Order — see Future Expansion Rules.
//
// NOTE (contract-driven columns): the World/Product/PWP models below follow
// backend-architecture.md §4, with three small additions required by the
// frontend DTOs in Frontend/lib/api/types.ts, which is the binding contract:
//   - World.tagline        (WorldSummaryDto requires a localized tagline)
//   - Product.baseTitle    (the no-world product view-model needs a title)
//   - PWP.subtitle / imageUrl / accentColor  (ProductViewModel fields)
// imageUrl is nullable because the mock catalog has no images and the DTO
// declares it optional.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model World {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      Json // LocalizedTextDto { en, ar }
  tagline   Json // LocalizedTextDto { en, ar }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  presentations ProductWorldPresentation[]
}

model Product {
  id        String   @id @default(cuid())
  slug      String   @unique
  baseTitle String
  basePrice Int // minor units (cents) — serialized to major units at the DTO boundary
  currency  String   @default("USD")
  createdAt DateTime @default(now())

  presentations ProductWorldPresentation[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

// The per-world "skin" of a product: what ProductCard actually renders.
// WorldConfig.productCard.fieldLabels supplies the *labels* ("Stars", "Rating");
// this table supplies the *values* for a given product in a given world.
model ProductWorldPresentation {
  id             String  @id @default(cuid())
  productId      String
  worldId        String
  title          Json // LocalizedTextDto { en, ar }
  subtitle       String?
  primaryValue   String
  secondaryValue String?
  imageUrl       String?
  accentColor    String?
  badge          String?
  isAvailable    Boolean @default(true)
  isFeatured     Boolean @default(false)
  sortWeight     Int     @default(0)

  product Product @relation(fields: [productId], references: [id])
  world   World   @relation(fields: [worldId], references: [id])

  @@unique([productId, worldId])
  @@index([worldId, isAvailable, sortWeight])
}

// A guest (or authenticated) shopping cart. Exactly as in backend-architecture.md
// §4: one cart per session, userId nullable until auth exists. Postgres is the
// source of truth; the cart:{sessionId} Redis key only caches the hydrated
// CartDto in front of it (architecture §6).
//
// sessionId is the operational key used by every CartService read/write: it
// holds the signed guest session id for guests, and the User.id once a guest
// authenticates and their cart is transferred/merged (see CartService.mergeGuestCart).
// userId is set at the same time to wire the User relation for the (future)
// loyalty/account modules — it is never used as a lookup key on its own.
model Cart {
  id        String   @id @default(cuid())
  sessionId String   @unique // guest session id (signed), or User.id once merged
  userId    String?  @unique // Phase 4: wired to User on authentication
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
  user  User?    @relation(fields: [userId], references: [id])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

// A placed order. Exactly as in backend-architecture.md §4 with ONE deliberate
// removal: `paymentMethodId` is gone (see the schema header note) — COD is
// implicit, there is no payment-method choice to store.
//
// userId is nullable until Phase 4 wires the User relation (mirrors Cart).
// All money columns are integer minor units (cents), consistent with
// Product.basePrice; order-totals.service.ts is the only place totals math
// lives, and it is always recomputed from the cart at creation time — a client
// never supplies subtotal/shipping/tax/total.
model Order {
  id              String      @id @default(cuid())
  sessionId       String // guest session at time of purchase, or User.id once authenticated
  userId          String? // Phase 4: wired to the User relation when the order is placed authenticated
  status          OrderStatus @default(PENDING) // every order starts PENDING; COD, no charge step
  shippingAddress Json // AddressDto
  subtotal        Int // cents
  shipping        Int // cents
  tax             Int // cents
  total           Int // cents
  currency        String      @default("USD")
  createdAt       DateTime    @default(now())

  items OrderItem[]
  user  User?      @relation(fields: [userId], references: [id])
}

// A line on an order. unitPrice is captured at purchase time and NEVER
// recomputed from the live Product row (rule 2) — a price change next week
// must not alter last week's order history. title/productSlug are not stored
// here (per §4); they are read through the Product join at DTO-mapping time,
// which is why this relation is required even though the join is read-only.
//
// worldSlug records "which world's presentation the item was purchased
// through" (§4). This phase's cart carries no world context (cart lines are
// world-agnostic — AddCartItemRequestDto has only productSlug), so order
// creation records a sentinel constant (NO_WORLD_SLUG in orders.service.ts)
// rather than inventing a world. When the cart gains world context, this
// column starts recording it without a schema change.
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  worldSlug String // sentinel until the cart carries world context (see above)
  quantity  Int
  unitPrice Int // cents, captured at purchase time — never recomputed

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// Exactly as backend-architecture.md §4. Note this deliberately differs from
// the FRONTEND's lib/api/types.ts OrderStatus ("PENDING | PAID | COMPLETED |
// CANCELLED | REFUNDED") — the architecture enum is the authority for the
// backend, and "PENDING" is the only status this phase ever writes.
enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

// The application User (Phase 4A). Firebase Authentication OWNS credentials —
// this table stores only application data keyed to the verified Firebase UID.
// firebaseUid is the stable identity across logins; email is denormalized for
// lookups/messages. Never store passwords, password hashes, ID tokens, or
// access/refresh tokens here (backend-architecture.md §7).
model User {
  id                String   @id @default(cuid())
  firebaseUid       String   @unique // verified Firebase UID (ID token subject)
  email             String   @unique
  name              String? // display name, when Firebase/profile provides one
  favoriteWorldSlug String? // mirrors UserDto.favoriteWorld; unused by any module today
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cart   Cart?
  orders Order[]
}
