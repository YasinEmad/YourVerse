# Copy to .env and adjust for your environment.
NODE_ENV=development
PORT=3001

# Postgres (Prisma-compatible URL)
DATABASE_URL=postgresql://user:password@localhost:5432/yourverse

# Redis
REDIS_URL=redis://localhost:6379

# Comma-separated allowlist of frontend origins (credentials: "include" cookies need exact origins)
CORS_ORIGINS=http://localhost:3000

# Short TTL for the catalog list cache (seconds)
CACHE_TTL_SECONDS=30

# HMAC secret that signs guest session ids (v1.<uuid>.<sig>)
SESSION_SIGNING_SECRET=replace-with-a-long-random-secret

# Guest session cookie lifetime (days) — must match the frontend's 30-day cookie.
SESSION_TTL_DAYS=30

# Short TTL for the cart:{sessionId} cache (seconds); invalidated on every write.
CART_CACHE_TTL_SECONDS=60
